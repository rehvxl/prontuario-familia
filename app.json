{
  "expo": {
    "name": "Prontuário da Família",
    "slug": "prontuario-familia",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.prontuariofamilia.app",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleLocalizations": [
          "pt-BR"
        ],
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.prontuariofamilia.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ArchivoSC-Regular.ttf",
            "./assets/fonts/ArchivoSC-Medium.ttf",
            "./assets/fonts/ArchivoSC-SemiBold.ttf",
            "./assets/fonts/ArchivoSC-Bold.ttf"
          ]
        }
      ],
      "expo-sharing",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Prontuário da Família acessa suas fotos para você anexar exames, laudos e receitas.",
          "cameraPermission": "O Prontuário da Família usa a câmera para fotografar exames, laudos e receitas.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F4F8",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1E2029"
          }
        }
      ]
    ],
    "scheme": "prontuariofamilia",
    "experiments": {
      "typedRoutes": true
    }
  }
}
