{
  "expo": {
    "name": "Prontuário da Família",
    "slug": "prontuario-familia",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.prontuariofamilia.app",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.prontuariofamilia.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      "expo-font",
      "expo-sharing",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Prontuário da Família acessa suas fotos para você anexar exames, laudos e receitas.",
          "cameraPermission": "O Prontuário da Família usa a câmera para fotografar exames, laudos e receitas.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "prontuariofamilia",
    "experiments": {
      "typedRoutes": true
    }
  }
}
