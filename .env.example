# Prontuário da Família — variáveis de ambiente.
# Copie para `.env` (já ignorado pelo git) e preencha. NUNCA coloque segredos em variáveis EXPO_PUBLIC_*:
# elas são embutidas no app e ficam visíveis para qualquer pessoa.

# ───────────── App (Expo) ─────────────

# URL do projeto Supabase.
#  - Local (npm run db:start):  http://127.0.0.1:54321   (no celular físico use o IP da sua máquina, ex.: http://192.168.0.10:54321)
#  - Produção: https://<ref>.supabase.co  (projeto criado em sa-east-1 — ver docs/BACKEND.md)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave pública "anon" (ou "publishable"). É pública por design: a segurança está nas políticas RLS.
# Local: copie "anon key" da saída de `npx supabase@latest status`. NUNCA use a service_role aqui.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 1 = mostra o botão "Entrar com Google" (só ligue depois de configurar o provedor Google no Supabase).
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=0

# 1 = força o modo demonstração (dados só no aparelho, sem Supabase). Em dev, sem URL/anon key o app já cai no demo.
EXPO_PUBLIC_DEMO_MODE=0

# ───────────── Supabase CLI / Auth (NÃO são EXPO_PUBLIC; ficam em supabase/.env, ignorado pelo git) ─────────────
# Lidos por supabase/config.toml via env(...). Para ativar um provedor, também troque `enabled = true`
# na seção [auth.external.apple] / [auth.external.google] do config.toml (enabled não aceita env()).

# Sign in with Apple (fluxo nativo no iOS). client_id = Bundle ID do app (ou Services ID, se usar OAuth web).
# O secret é um JWT assinado com a chave .p8 da Apple e expira em até 6 meses: precisa ser renovado.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Google OAuth (navegador). Crie um "OAuth client ID" do tipo Web no Google Cloud Console e cadastre como
# redirect URI: <SUPABASE_URL>/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# SMTP próprio (produção): o e-mail embutido do Supabase tem limite baixo e não serve para lançamento.
# Configure no painel (Authentication → SMTP) — não é lido pelo app.
